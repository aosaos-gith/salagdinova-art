---
import Base from "../layouts/Base.astro";
import { localePath, t, type Locale } from "../i18n";

interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
Astro.response.status = 404;
---

<Base locale={locale} title="404" robots="noindex">
	<section class="page notfound">
		<h1 class="page__title">404</h1>
		<div class="page__body">
			<p>{t(locale, "notFound")}</p>
			<p><a href={localePath(locale, "/")}>{t(locale, "home")}</a></p>
		</div>
	</section>
</Base>
